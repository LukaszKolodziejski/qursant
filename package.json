{
  "name": "@qursant/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx serve qursant",
    "build": "nx build qursant",
    "start": "nx serve qursant --prod",
    "test": "nx test qursant",
    "e2e": "nx e2e qursant-e2e",
    "lint": "nx lint qursant",
    "clean": "nx reset && rm -rf dist .next node_modules/.cache",
    "format": "nx format:write",
    "graph": "nx graph",
    "serve:prod": "nx serve qursant --configuration=production",
    "analyze": "ANALYZE=true nx build qursant",
    "typecheck": "nx typecheck qursant",
    "lint:fix": "nx lint qursant --fix",
    "update": "nx migrate latest",
    "dep-graph": "nx dep-graph",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "nx-cloud": "nx-cloud",
    "workspace-generator": "nx workspace-generator",
    "vercel-build": "nx build qursant",
    "gallery": "node apps/qursant/scripts/generateGalleryData.js",
    "blog": "node scripts/generate-blog-week.js",
    "optimize-images": "node scripts/optimize-images.js",
    "blog:list": "ls -lh apps/qursant/data/blog-content/ | grep week",
    "blog:stats": "echo '📊 Statystyki blogów:' && find apps/qursant/data/blog-content -name 'week-*.json' | wc -l | xargs -I {} echo '   Tygodni: {}' && echo '   Blogów: ~7 na tydzień' && find apps/qursant/data/blog-content -name 'week-*.json' | wc -l | xargs -I {} echo '   Łącznie: ~$(({}*7))' || echo 'Brak blogów'",
    "blog:clean": "rm -rf apps/qursant/data/blog-content/week-*.json && echo '✅ Wyczyszczono wszystkie blogi'",
    "blog:help": "echo '\n📝 Komendy do zarządzania blogami:\n\n  npm run blog <numer>     - Generuj tydzień (np. npm run blog 4)\n  npm run blog:list        - Lista wygenerowanych tygodni\n  npm run blog:stats       - Statystyki blogów\n  npm run blog:clean       - Usuń wszystkie blogi\n  npm run blog:help        - Ta pomoc\n'",
    "seo": "node scripts/seo-audit.js",
    "seo:help": "echo '\n🔍 SEO Audit Tool:\n\n  npm run seo              - Pełna analiza SEO\n  npm run seo:help         - Ta pomoc\n'",
    "lighthouse": "npx unlighthouse-ci --site http://localhost:3000 --build-static",
    "lighthouse:prod": "npx unlighthouse-ci --site https://www.qursant.com.pl --build-static",
    "audit": "echo '\n🔍 Dostępne audyty:\n\n  npm run seo              - Szybki audit SEO (pliki, 2s)\n  npm run lighthouse       - Pełny audit Lighthouse (localhost, 2-5 min)\n  npm run lighthouse:prod  - Pełny audit Lighthouse (produkcja, 2-5 min)\n'"
  },
  "private": true,
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@nx/next": "20.7.1",
    "@react-google-maps/api": "^2.20.6",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.17",
    "@types/node": "18.16.9",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "country-flag-icons": "^1.5.18",
    "framer-motion": "^12.6.3",
    "leaflet": "^1.9.4",
    "next": "~15.2.4",
    "next-intl": "^4.0.2",
    "nodemailer": "^7.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "resend": "^4.5.1",
    "styled-jsx": "5.1.1",
    "three": "^0.175.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^2.1.1",
    "@eslint/js": "^9.8.0",
    "@nx/cypress": "20.7.1",
    "@nx/eslint": "20.7.1",
    "@nx/eslint-plugin": "20.7.1",
    "@nx/js": "20.7.1",
    "@nx/workspace": "20.7.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/nodemailer": "^6.4.17",
    "@unlighthouse/cli": "^0.17.4",
    "autoprefixer": "10.4.13",
    "cypress": "^13.13.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "nx": "20.7.1",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "puppeteer": "^24.29.1",
    "sharp": "^0.34.1",
    "tailwindcss": "3.4.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
